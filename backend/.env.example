# APP_ENV, APP_DEBUG, LOG_CHANNEL, LOG_LEVEL, REDIS_CLIENT/HOST/PORT, OUTBOX_REDIS_DB/STREAM_NAME и SUPPORT_BFF_SHARED_SECRET задаются через infra/.env при запуске Compose.
APP_NAME=AutoBI
APP_KEY=base64:6Wf3dY1v8s4p2n0m9k7j5h3g1f0d8c6b4a2z1x0w=
APP_URL=http://localhost:8080

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=autobi
DB_USERNAME=autobi
DB_PASSWORD=autobi

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Outbox / Integration Events
# Maximum messages to publish per batch
OUTBOX_BATCH_SIZE=100
# Seconds after which a 'processing' message lock is considered stale
OUTBOX_STALE_LOCK_SECONDS=600
# Maximum delivery attempts before marking as 'failed'
OUTBOX_MAX_ATTEMPTS=10

GEMMA_API_KEY=
SUPPORT_AI_ADAPTER=disabled # disabled/deterministic/google
SUPPORT_GOOGLE_CHAT_MODEL=gemma-4-26b-a4b-it
SUPPORT_GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
SUPPORT_GOOGLE_EMBEDDING_DIMENSIONS=768
SUPPORT_GOOGLE_THINKING_LEVEL=minimal
SUPPORT_PROMPT_VERSION=support-google-v1
SUPPORT_RETENTION_DAYS=7
SUPPORT_GENERATION_QUEUE=ai-generation
SUPPORT_INDEXING_QUEUE=ai-indexing
SUPPORT_WORKSPACE_DAILY_TOKEN_BUDGET=200000
SUPPORT_ENVIRONMENT_DAILY_TOKEN_BUDGET=1000000
SUPPORT_INDEXING_DAILY_TOKEN_BUDGET=500000
SUPPORT_MINIMUM_RRF_SCORE=0.025
SUPPORT_MINIMUM_HYBRID_VECTOR_SCORE=0.65
SUPPORT_MINIMUM_SEMANTIC_VECTOR_SCORE=0.70
SUPPORT_RETRIEVAL_PROFILE=hybrid-rrf-v2
