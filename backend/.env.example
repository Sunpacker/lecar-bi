APP_NAME=AutoBI
APP_ENV=local
APP_KEY=base64:6Wf3dY1v8s4p2n0m9k7j5h3g1f0d8c6b4a2z1x0w=
APP_DEBUG=true
APP_URL=http://localhost:8080


DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=autobi
DB_USERNAME=autobi
DB_PASSWORD=autobi

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Outbox / Integration Events
# Redis database for integration events stream (isolated from default=0 and cache=1)
OUTBOX_REDIS_DB=2
# Redis Stream name for integration events
OUTBOX_STREAM_NAME=autobi.integration-events
# Maximum messages to publish per batch
OUTBOX_BATCH_SIZE=100
# Seconds after which a 'processing' message lock is considered stale
OUTBOX_STALE_LOCK_SECONDS=600
# Maximum delivery attempts before marking as 'failed'
OUTBOX_MAX_ATTEMPTS=10