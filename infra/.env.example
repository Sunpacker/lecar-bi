COMPOSE_PROJECT_NAME=autobi

FRONTEND_IMAGE=autobi/frontend:latest
BACKEND_IMAGE=autobi/backend:latest
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:8080/api/v1
ANALYTICS_INTERNAL_URL=http://backend:8080/api/v1

APP_NAME=AutoBI
APP_ENV=local
APP_KEY=base64:6Wf3dY1v8s4p2n0m9k7j5h3g1f0d8c6b4a2z1x0w=
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=debug

POSTGRES_DB=autobi
POSTGRES_USER=autobi
POSTGRES_PASSWORD=autobi

NOTIFICATION_IMAGE=autobi/notification:latest
NOTIFICATION_PORT=8081
NOTIFICATION_POSTGRES_PORT=5433
NOTIFICATION_APP_NAME=NotificationService
