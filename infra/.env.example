# Общие параметры запуска Compose. Сервисные .env.example содержат настройки самого приложения.
COMPOSE_PROJECT_NAME=autobi

FRONTEND_IMAGE=autobi/frontend:latest
BACKEND_IMAGE=autobi/backend:latest
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

FRONTEND_PORT=3000
BACKEND_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_HOST=redis

NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_API_URL=http://localhost:8080/api/v1
ANALYTICS_INTERNAL_URL=http://backend:8080/api/v1
SESSION_SECRET=replace-with-at-least-32-random-characters
SUPPORT_BFF_SHARED_SECRET=
GEMMA_API_KEY=
SUPPORT_AI_ADAPTER=disabled
SUPPORT_GOOGLE_CHAT_MODEL=gemma-4-26b-a4b-it
SUPPORT_GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
SUPPORT_GOOGLE_EMBEDDING_DIMENSIONS=768
SUPPORT_GOOGLE_THINKING_LEVEL=minimal
SUPPORT_PROMPT_VERSION=support-google-v1
SUPPORT_RETENTION_DAYS=7
SUPPORT_MINIMUM_RRF_SCORE=0.025
SUPPORT_MINIMUM_HYBRID_VECTOR_SCORE=0.65
SUPPORT_MINIMUM_SEMANTIC_VECTOR_SCORE=0.70
SUPPORT_RETRIEVAL_PROFILE=hybrid-rrf-v2

APP_NAME=AutoBI
APP_ENV=local
APP_KEY=base64:6Wf3dY1v8s4p2n0m9k7j5h3g1f0d8c6b4a2z1x0w=
APP_DEBUG=true
APP_URL=http://localhost:8080
LOG_CHANNEL=stderr
LOG_LEVEL=debug

POSTGRES_DB=autobi
POSTGRES_USER=autobi
POSTGRES_PASSWORD=autobi

NOTIFICATION_IMAGE=autobi/notification:latest
NOTIFICATION_PORT=8081
NOTIFICATION_POSTGRES_PORT=5433
NOTIFICATION_APP_NAME=NotificationService
NOTIFICATION_APP_KEY=base64:6Wf3dY1v8s4p2n0m9k7j5h3g1f0d8c6b4a2z1x0w=
NOTIFICATION_APP_URL=http://localhost:8081
NOTIFICATION_POSTGRES_DB=notification
NOTIFICATION_POSTGRES_USER=notification
NOTIFICATION_POSTGRES_PASSWORD=notification

INTEGRATION_EVENTS_REDIS_DB=2
INTEGRATION_STREAM_NAME=autobi.integration-events
INTEGRATION_GROUP_NAME=notification-service-v1
INTEGRATION_DEAD_LETTER_STREAM=autobi.integration-events.dead-letter
