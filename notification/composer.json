{
  "name": "autobi/notification",
  "description": "AutoBI notification service",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^13.0",
    "predis/predis": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "laravel/pint": "^1.16",
    "larastan/larastan": "^3.12",
    "symfony/yaml": "^7.4",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "NotificationService\\": "app/",
      "NotificationService\\Database\\Factories\\": "database/factories/",
      "NotificationService\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NotificationService\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "./vendor/bin/phpunit",
    "lint": [
      "@lint:style",
      "@lint:types"
    ],
    "lint:style": "./vendor/bin/pint --test",
    "lint:types": "./vendor/bin/phpstan analyse --debug --no-progress",
    "lint:fix": "./vendor/bin/pint"
  }
}
